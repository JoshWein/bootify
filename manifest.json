{
  "manifest_version": 3,
  "name": "bootify - A Bootstrap Injector",
  "version": "1.0.0",
  "description": "Injects Bootstrap styling into any page. Save sites to style them automatically.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Add bootstrap to page."
  },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["load.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["bootstrap.min.css"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
